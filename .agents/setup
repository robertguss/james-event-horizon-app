#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export PATH="$HOME/.local/bin:$PATH"

step() {
  printf '\n==> %s\n' "$1"
}

run_timed() {
  local label="$1"
  shift
  local started_at=$SECONDS

  "$@"
  printf '    %s completed in %ss\n' "$label" "$((SECONDS - started_at))"
}

step "Checking the Node.js runtime"
command -v node >/dev/null
command -v npm >/dev/null
node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 20 || (major === 20 && minor < 9)) {
    console.error(`Node.js 20.9+ is required; found ${process.version}`);
    process.exit(1);
  }
'
printf '    Using Node.js %s\n' "$(node --version)"

step "Installing aube when needed"
if ! command -v aube >/dev/null; then
  run_timed "aube installation" \
    npm install --global --prefix "$HOME/.local" --ignore-scripts=false @endevco/aube@latest
fi

for executable in aube aubr aubx; do
  command -v "$executable" >/dev/null
done
printf '    Using %s\n' "$(aube --version | head -n 1)"

step "Installing project dependencies from aube-lock.yaml"
run_timed "dependency installation" aube install --frozen-lockfile

step "Preparing fixture-first local configuration"
if [[ ! -f .env.local ]]; then
  cp -- .env.example .env.local
  printf '    Created .env.local from .env.example\n'
else
  printf '    Preserved existing .env.local\n'
fi

printf '\nOrb setup complete.\n'
