# AI Starter Kit - Environment Variables Example
# Copy this file to .env.local for local development

# =============================================================================
# EVENT HORIZON DATA MODE (Slice 1 overnight default)
# =============================================================================

# Single env name: VITE_EH_DATA (optional legacy alias VITE_EH_DATA_MODE;
# if either is convex, convex wins).
#
# DEV / overnight / CI: fixture (unset in non-prod also → fixture).
# PROD / preview builds: unset is NOT fixture (fail-closed hosted stack).
# UI imports product data only from lib/eh/data.
# Fixture kid: James · parent PIN: 1234 (dev/fixture only) · lands on /hub
# Do not mount hosted Clerk in fixture mode.
VITE_EH_DATA=fixture

# Mac morning (after repo scripts below): change this to convex
# VITE_EH_DATA=convex

# =============================================================================
# CONVEX (Auto-generated by `aubx convex dev`)
# =============================================================================

# Your Convex deployment URL
# This is automatically created when you run `aubx convex dev`
# DO NOT manually set this - let Convex generate it (setup.sh also ensures VITE_)
# Not required when VITE_EH_DATA=fixture
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# =============================================================================
# CLERK (prefer Clerk CLI setup) — not required in fixture mode
# =============================================================================

# Recommended (after Convex is linked):
#   aubx clerk@latest auth login
#   ./scripts/setup-clerk-auth.sh
#   # or: aubr setup:clerk
#
# That script creates/links a Clerk app, pulls keys, creates the Convex JWT
# template, and sets CLERK_JWT_ISSUER_DOMAIN. Do NOT run `clerk init` in this
# kit; providers and auth routes already exist.
#
# Dashboard fallback:
#   https://dashboard.clerk.com/apps/new
#   https://dashboard.clerk.com/last-active?path=api-keys
#   https://dashboard.clerk.com/apps/setup/convex
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Keep kit routes; Clerk path-based components use these
VITE_CLERK_SIGN_IN_URL=/login
VITE_CLERK_SIGN_UP_URL=/signup
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hub
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hub

# =============================================================================
# CONVEX ENVIRONMENT VARIABLES (Set via `aubx convex env set`)
# =============================================================================

# Set automatically by ./scripts/setup-clerk-auth.sh
# Manual: aubx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-clerk-frontend-api-url
# Dev format: https://verb-noun-00.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-00.clerk.accounts.dev

# Parent PIN hashing (SHA-256 pepper). Required for onboarding / parent gate in live mode.
# aubx convex env set PIN_PEPPER <long-random-secret>

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# Overnight green (no Clerk keys, no Convex URL):
#    VITE_EH_DATA=fixture aubr check
#    VITE_EH_DATA=fixture aubr test:once
#
# Prefer the kit scripts for Mac morning live flip:
#    ./setup.sh --yes --no-dev
#    aube install
#    aubx convex dev --until-success    # writes VITE_CONVEX_URL
#    aubx clerk@latest auth login       # browser OAuth — Mac / shared machine
#    ./scripts/setup-clerk-auth.sh      # or: aubr setup:clerk
#    aubx convex env set PIN_PEPPER "$(openssl rand -hex 32)"
#    # set VITE_EH_DATA=convex in .env.local
#    aubr dev
#
# Morning checklist: docs/EVENT-HORIZON-V1-IMPLEMENTATION-PLAN.md §13
# Clerk CLI agents: https://clerk.com/cli/agents.txt

# =============================================================================
# PRODUCTION
# =============================================================================

# Use production Clerk keys and issuer domain for prod deployments.
# aubx convex env set CLERK_JWT_ISSUER_DOMAIN https://clerk.your-domain.com --prod
# Set VITE_CONVEX_URL and Clerk keys in your host (e.g. Vercel).

# =============================================================================
# NOTES
# =============================================================================

# - Never commit .env.local to git (it's in .gitignore)
# - Use different Clerk instances/keys for development and production
# - Convex env variables live in Convex cloud, not in .env.local
# - Only VITE_* variables are exposed to the browser (via Vite)
# - See docs/EVENT-HORIZON-V1-IMPLEMENTATION-PLAN.md §13 for Mac morning flip
